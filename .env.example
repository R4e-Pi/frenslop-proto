# copy to .env and edit
PORT=8090

# ollama (default) or mock (canned mods, no model needed)
LLM_PROVIDER=ollama
OLLAMA_URL=http://192.168.1.213:11434
# proven on the Jetson Orin Nano: qwen2.5:3b at 4096 (100% GPU).
# qwen2.5:7b only fits at 4096 and only on unfragmented memory (see README).
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_CTX=4096
# -1 = keep the model loaded forever (use with a pinned model on the Jetson)
OLLAMA_KEEP_ALIVE=30m
# OLLAMA_NUM_PREDICT=1433   # max reply tokens; defaults to 35% of NUM_CTX
LLM_ATTEMPTS=3
LLM_TIMEOUT_MS=240000
