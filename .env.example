# copy to .env and edit
PORT=8090

# ollama (default) or mock (canned mods, no model needed)
LLM_PROVIDER=ollama
OLLAMA_URL=http://192.168.1.213:11434
OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_MODEL=qwen2.5-coder:7b   # usually better at writing mod code
OLLAMA_NUM_CTX=8192
LLM_ATTEMPTS=3
LLM_TIMEOUT_MS=240000
